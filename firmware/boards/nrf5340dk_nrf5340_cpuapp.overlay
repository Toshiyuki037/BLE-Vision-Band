&arduino_i2c {
	status = "okay";

	drv2605l: drv2605l@5a {
		compatible = "ti,drv2605";
		reg = <0x5a>;
		actuator-mode = "ERM";
	};
};

/ {
	aliases {
		vision-red = &vision_red;
		vision-green = &vision_green;
		vision-blue = &vision_blue;
	};

	leds {
		compatible = "gpio-leds";

		vision_red: vision_red {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
			label = "Vision RGB Red";
		};

		vision_green: vision_green {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
			label = "Vision RGB Green";
		};

		vision_blue: vision_blue {
			gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
			label = "Vision RGB Blue";
		};
	};
};

&arduino_i2c {
	status = "okay";

	drv2605l: drv2605l@5a {
		compatible = "ti,drv2605";
		reg = <0x5a>;
		actuator-mode = "ERM";
	};
};
